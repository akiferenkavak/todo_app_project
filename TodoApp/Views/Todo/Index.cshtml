@model List<TodoApp.Models.Todo>

@{
    ViewData["Title"] = "Todo List";
    var todoToEdit = ViewBag.TodoToEdit as TodoApp.Models.Todo;
    bool isEditMode = todoToEdit != null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body class="container py-4">

    <h1 class="mb-4">@(isEditMode ? "Edit Todo" : "Add Todo")</h1>

    <form asp-action="@(isEditMode ? "Update" : "Add")" method="post" class="row g-3 mb-5">
        @if (isEditMode && todoToEdit != null)
        {
            <input type="hidden" name="id" value="@todoToEdit.Id" />
        }
        <div class="col-md-4">
            <label for="Title" class="form-label">Title</label>
            <input name="Title" class="form-control" value="@(todoToEdit?.Title ?? "")" required />
        </div>

        <div class="col-md-5">
            <label for="Description" class="form-label">Description</label>
            <input name="Description" class="form-control" value="@(todoToEdit?.Description ?? "")" required />
        </div>

        <div class="col-md-3">
            <label for="CategoryId" class="form-label">Category</label>
            <select name="CategoryId" class="form-select" required>
                <option value="">Select a category</option>
                @foreach (var category in ViewBag.Categories)
                {
                    <option value="@category.Id" selected="@(todoToEdit?.CategoryId == category.Id ? "selected" : null)">
                        @category.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-12 d-flex justify-content-end">
            <button type="submit" class="btn btn-primary">
                @(isEditMode ? "Save" : "Add")
            </button>
        </div>
    </form>

    <form asp-action="FilterByCategory" asp-controller="Todo" method="get" class="mb-4 row g-2">
        <div class="col-md-4">
            <select name="categoryId" class="form-select" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var category in ViewBag.Categories)
                {
                    <option value="@category.Id" selected="@(ViewBag.SelectedCategoryId == category.Id ? "selected" : null)">
                        @category.Name
                    </option>
                }
            </select>
        </div>
    </form>

    <h2 class="mb-3">Todos</h2>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Title</th>
                <th>Description</th>
                <th>Category</th>
                <th>Completed?</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var todo in Model)
            {
                <tr>
                    <td>@todo.Id</td>
                    <td>@todo.Title</td>
                    <td>@todo.Description</td>
                    <td>@todo.Category?.Name</td>
                    <td>
                        @if (!todo.IsCompleted)
                        {
                            <form asp-action="Complete" method="post" asp-route-id="@todo.Id">
                                <button type="submit" class="btn btn-sm btn-success">Complete</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">✓ Completed</span>
                        }
                    </td>
                    <td>
                        @if (!todo.IsCompleted)
                        {
                            <form asp-action="Complete" method="post" asp-route-id="@todo.Id">
                                <button type="submit" class="btn btn-sm btn-success">Complete</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">✓ Completed</span>
                        }

                        <form asp-action="Delete" method="post" asp-route-id="@todo.Id"
                              onsubmit="return confirm('Are you sure you want to delete this task?');">
                            <button type="submit" class="btn btn-sm btn-danger mt-1">Delete</button>
                        </form>
                        <form asp-action="Edit" method="get" asp-route-id="@todo.Id" class="mt-1">
                            <button type="submit" class="btn btn-sm btn-warning">Edit</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</body>
</html>
